# `.env.dev.local`로 복사한 뒤 개발 환경에서만 값을 변경합니다.
POSTGRES_DB=our_ledger
POSTGRES_USER=our_ledger
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_PORT=5432

# 기본값은 비활성이다. local에서 최초 provision할 때만 true로 바꾼다.
OUR_LEDGER_BOOTSTRAP_ENABLED=false
OUR_LEDGER_BOOTSTRAP_HOUSEHOLD_NAME=테스트 Household
OUR_LEDGER_BOOTSTRAP_OWNER_EMAIL=owner@example.test
OUR_LEDGER_BOOTSTRAP_OWNER_DISPLAY_NAME=Owner
OUR_LEDGER_BOOTSTRAP_MEMBER_EMAIL=member@example.test
OUR_LEDGER_BOOTSTRAP_MEMBER_DISPLAY_NAME=Member

# Vite development proxy에서만 사용하는 가짜 local identity다.
OUR_LEDGER_LOCAL_IDENTITY_EMAIL=owner@example.test

# production 전용 Cloudflare Access 값은 별도 secret/운영 설정으로 주입한다.
CLOUDFLARE_ACCESS_ISSUER=
CLOUDFLARE_ACCESS_JWK_SET_URI=
CLOUDFLARE_ACCESS_AUDIENCE=
