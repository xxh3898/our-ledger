# 실제 값과 운영 credential은 이 파일에 기록하지 않는다.
# image는 CI가 발행한 exact commit SHA tag 또는 digest로 교체한다.
OUR_LEDGER_WEB_IMAGE=ghcr.io/xxh3898/our-ledger-web:sha-replace-with-full-commit
OUR_LEDGER_API_IMAGE=ghcr.io/xxh3898/our-ledger-api:sha-replace-with-full-commit
OUR_LEDGER_ORIGIN_PORT=18080

POSTGRES_DB=our_ledger
POSTGRES_USER=our_ledger
POSTGRES_PASSWORD=replace-with-a-long-random-secret

CLOUDFLARE_ACCESS_ISSUER=https://example.cloudflareaccess.com
CLOUDFLARE_ACCESS_JWK_SET_URI=https://example.cloudflareaccess.com/cdn-cgi/access/certs
CLOUDFLARE_ACCESS_AUDIENCE=replace-with-access-application-audience
